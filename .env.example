# Copy to .env.local and fill with YOUR Firebase web app config (Firebase console > Project settings > Your apps).
# Never commit .env.local. Do not paste these values in chats.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA v3 site key, free) for the hosted build. Local dev uses the debug provider.
VITE_RECAPTCHA_V3_SITE_KEY=
# Set to true only for the judges' build if you rely on a registered debug token (allowed by the rules).
VITE_APPCHECK_DEBUG=false
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
